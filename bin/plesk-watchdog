#!/usr/bin/env bash
# Plesk Apache watchdog.
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

: "${WATCHDOG_CONFIG:="$PROJECT_DIR/config/plesk-watchdog.conf"}"
: "${WATCHDOG_LOG:="$PROJECT_DIR/var/watchdog.log"}"
: "${WATCHDOG_STATE_DIR:="$PROJECT_DIR/var"}"
: "${WATCHDOG_LOCK_FILE:="$WATCHDOG_STATE_DIR/plesk-watchdog.lock"}"
: "${WATCHDOG_DOMAIN_COMMAND:="plesk bin site --list"}"

: "${WATCHDOG_CURL_COMMAND:="curl"}"
: "${WATCHDOG_SYSTEMCTL_COMMAND:="systemctl"}"
: "${WATCHDOG_SLEEP_COMMAND:="sleep"}"
: "${WATCHDOG_APACHE_SERVICE:=apache2}"
: "${WATCHDOG_SCHEME:=https}"
: "${WATCHDOG_PATH:=/}"
: "${WATCHDOG_DELAY_SECONDS:=30}"
: "${WATCHDOG_FAILURE_THRESHOLD:=3}"
: "${WATCHDOG_RESTART_COOLDOWN_SECONDS:=300}"
: "${WATCHDOG_CONNECT_TIMEOUT_SECONDS:=10}"
: "${WATCHDOG_REQUEST_TIMEOUT_SECONDS:=30}"
: "${WATCHDOG_USER_AGENT:=plesk-watchdog/1.0}"
: "${WATCHDOG_SUCCESS_MIN:=200}"
: "${WATCHDOG_SUCCESS_MAX:=399}"
: "${WATCHDOG_ACCEPTED_STATUS_CODES:=503}"

load_config() {
    if [[ -f "$WATCHDOG_CONFIG" ]]; then
        # shellcheck disable=SC1090
        source "$WATCHDOG_CONFIG"
    fi
}

validate_config() {
    local value name
    for name in WATCHDOG_DELAY_SECONDS WATCHDOG_FAILURE_THRESHOLD \
        WATCHDOG_RESTART_COOLDOWN_SECONDS WATCHDOG_CONNECT_TIMEOUT_SECONDS \
        WATCHDOG_REQUEST_TIMEOUT_SECONDS WATCHDOG_SUCCESS_MIN WATCHDOG_SUCCESS_MAX; do
        value="${!name}"
        [[ "$value" =~ ^[0-9]+$ ]] || { printf 'Invalid numeric setting: %s=%s\n' "$name" "$value" >&2; return 1; }
    done
    (( WATCHDOG_FAILURE_THRESHOLD > 0 )) || { printf 'WATCHDOG_FAILURE_THRESHOLD must be greater than zero\n' >&2; return 1; }
    (( WATCHDOG_SUCCESS_MIN <= WATCHDOG_SUCCESS_MAX )) || { printf 'Invalid HTTP success range\n' >&2; return 1; }
    mkdir -p "$WATCHDOG_STATE_DIR" "$(dirname "$WATCHDOG_LOG")"
    touch "$WATCHDOG_LOG"
}

run_command() {
    local command_line="$1"
    shift
    # Commands are configurable for testing and for Plesk-specific deployment.
    # shellcheck disable=SC2086
    $command_line "$@"
}

command_output() {
    local command_line="$1"
    # shellcheck disable=SC2086
    $command_line
}

valid_hostname() {
    [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\.?$ ]]
}

status_is_accepted() {
    local status="$1" accepted_code
    if (( status >= WATCHDOG_SUCCESS_MIN && status <= WATCHDOG_SUCCESS_MAX )); then
        return 0
    fi
    IFS=',' read -r -a accepted_codes <<< "$WATCHDOG_ACCEPTED_STATUS_CODES"
    for accepted_code in "${accepted_codes[@]}"; do
        [[ "$status" == "$accepted_code" ]] && return 0
    done
    return 1
}

discover_domains() {
    local output domain

    output="$(command_output "$WATCHDOG_DOMAIN_COMMAND" 2>/dev/null)" || {
        printf 'Unable to obtain domains using: %s\n' "$WATCHDOG_DOMAIN_COMMAND" >&2
        return 1
    }
    printf '%s\n' "$output" | awk 'NF {print $1}' | sed -E 's/[[:space:]]+$//' | while IFS= read -r domain; do
        valid_hostname "$domain" || continue
        printf '%s\n' "$domain"
    done | awk '!seen[$0]++'
}

health_url() {
    local domain="$1" timestamp separator
    timestamp="$(date +%s)"
    separator='?'
    [[ "$WATCHDOG_PATH" == *\?* ]] && separator='&'
    printf '%s://%s%s%shealth=%s' "$WATCHDOG_SCHEME" "$domain" "$WATCHDOG_PATH" "$separator" "$timestamp"
}

health_check() {
    local domain="$1" url status response
    url="$(health_url "$domain")"
    if ! response="$(run_command "$WATCHDOG_CURL_COMMAND" \
        --silent --show-error --location --insecure \
        --connect-timeout "$WATCHDOG_CONNECT_TIMEOUT_SECONDS" \
        --max-time "$WATCHDOG_REQUEST_TIMEOUT_SECONDS" \
        --user-agent "$WATCHDOG_USER_AGENT" \
        --header 'Cache-Control: no-cache, no-store, max-age=0' \
        --header 'Pragma: no-cache' \
        --output /dev/null --write-out '%{http_code}' "$url" 2>&1)"; then
        response="${response//$'\n'/ }"
        printf 'health_check_failed domain=%s detail=%s\n' "$domain" "$response" >&2
        return 1
    fi
    status="$response"
    if [[ ! "$status" =~ ^[0-9]{3}$ ]]; then
        printf 'health_check_failed domain=%s detail=invalid_http_status:%s\n' "$domain" "$status" >&2
        return 1
    fi
    if ! status_is_accepted "$status"; then
        printf 'health_check_failed domain=%s http_status=%s\n' "$domain" "$status" >&2
        return 1
    fi
    return 0
}

log_restart() {
    local result="$1" triggering_domain="$2" failure_count="$3" last_domain="$4"
    printf '%s restart=%s service=%s triggering_domain=%s failures=%s last_domain=%s\n' \
        "$(date --iso-8601=seconds)" "$result" "$WATCHDOG_APACHE_SERVICE" \
        "$triggering_domain" "$failure_count" "$last_domain" >> "$WATCHDOG_LOG"
}

restart_apache() {
    local triggering_domain="$1" failure_count="$2" last_domain="$3"
    local now last_restart=0
    if [[ -f "$WATCHDOG_STATE_DIR/last-restart.epoch" ]]; then
        read -r last_restart < "$WATCHDOG_STATE_DIR/last-restart.epoch" || last_restart=0
    fi
    now="$(date +%s)"
    if (( WATCHDOG_RESTART_COOLDOWN_SECONDS > 0 && now - last_restart < WATCHDOG_RESTART_COOLDOWN_SECONDS )); then
        log_restart 'skipped_cooldown' "$triggering_domain" "$failure_count" "$last_domain"
        return 0
    fi
    if run_command "$WATCHDOG_SYSTEMCTL_COMMAND" is-active --quiet "$WATCHDOG_APACHE_SERVICE"; then
        :
    fi
    if run_command "$WATCHDOG_SYSTEMCTL_COMMAND" restart "$WATCHDOG_APACHE_SERVICE"; then
        printf '%s\n' "$now" > "$WATCHDOG_STATE_DIR/last-restart.epoch"
        log_restart 'success' "$triggering_domain" "$failure_count" "$last_domain"
        return 0
    fi
    log_restart 'failed' "$triggering_domain" "$failure_count" "$last_domain"
    return 1
}

run_pass() {
    local domains domain failure_count=0 last_domain='' restarted=0
    domains="$(discover_domains)" || return 1
    [[ -n "$domains" ]] || { printf 'No primary domains found.\n' >&2; return 1; }
    while IFS= read -r domain; do
        [[ -n "$domain" ]] || continue
        last_domain="$domain"
        if ! health_check "$domain"; then
            ((failure_count += 1))
            if (( failure_count >= WATCHDOG_FAILURE_THRESHOLD )); then
                restart_apache "$domain" "$failure_count" "$last_domain" || true
                restarted=1
                break
            fi
        fi
        run_command "$WATCHDOG_SLEEP_COMMAND" "$WATCHDOG_DELAY_SECONDS"
    done <<< "$domains"
    (( restarted == 1 )) && return 0
    return 0
}

run_forever() {
    while true; do
        run_pass || true
    done
}

main() {
    load_config
    validate_config
    exec {lock_fd}>"$WATCHDOG_LOCK_FILE"
    flock -n "$lock_fd" || { printf 'Another watchdog instance is already running.\n' >&2; return 1; }
    run_forever
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
